<Page x:Class="ObuvApp_Kumyshbaeva.Pages.ProductListManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ObuvApp_Kumyshbaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductListManagerPage">

    <Grid Background="#7FFF00">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="1"
               Grid.ColumnSpan="4"
               Text="Список товаров"
               FontSize="22"
               HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4"
                   Name="FIOTbl"
                   TextWrapping="Wrap"
           FontSize="22"
           HorizontalAlignment="Center"
          VerticalAlignment="Center"/>
        <Image Source="/Resources/Icon.png"/>
        <ComboBox Name="SupplierCmb"
                  ItemsSource="{Binding suppliers}"
                  SelectionChanged="SupplierCmb_SelectionChanged"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="30 20">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="20"
                               Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Name="SortProductsCmb"
                  Grid.Column="2"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="30 20"
                  SelectionChanged="SortProductsCmb_SelectionChanged">
            <ComboBoxItem Content="По возрастанию"
                          FontSize="18"/>
            <ComboBoxItem Content="По убыванию"
                          FontSize="18"/>
            <ComboBoxItem Content="Сброс сортировки"
                          FontSize="18"/>
        </ComboBox>
        <TextBox Grid.Column="4"
                 Grid.Row="1"
                 Grid.ColumnSpan="2"
                 Margin="30 20"
                 FontSize="18"
                 VerticalContentAlignment="Center"
                 Name="SearchProductTb"
                 TextChanged="SearchProductTb_TextChanged"/>
        <ListView Grid.Row="2"
              Grid.ColumnSpan="6"
                  Name="productsLv"
              Grid.RowSpan="4"
              ItemsSource="{Binding products}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"
                        BorderThickness="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image Height="150"
                               Width="150"
                               Margin="10 0">
                                <Image.Source >
                                    <Binding Path="Photo">
                                        <Binding.TargetNullValue>
                                            <ImageSource>/Resources/picture.png</ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>
                            <StackPanel Grid.Column="1"
                                    Width="700">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProductCategory.Name}"
                                       FontSize="18"/>
                                    <TextBlock Text="{Binding Name, StringFormat={} | {0}}"
                                       FontSize="18"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description, StringFormat={}Описание товара: {0}}"
                                   FontSize="18"/>
                                <TextBlock Text="{Binding Manufacturer.Name, StringFormat={}Производитель: {0}}"
                                   FontSize="18"/>
                                <TextBlock Text="{Binding Supplier.Name, StringFormat={}Поставщик: {0}}"
                                   FontSize="18"/>
                                <TextBlock Text="{Binding Price, StringFormat={}Цена: {0}}"
                                   FontSize="18"/>
                                <TextBlock Text="{Binding Unit.Name, StringFormat={}Единица измерения: {0}}"
                                   FontSize="18"/>
                                <TextBlock Text="{Binding WorkshopCount, StringFormat={}Количество на складе: {0}}"
                                   FontSize="18"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Grid.Column="5"
                Name="OrderBtn"
                Click="OrderBtn_Click"
                Content="Заказы"
                FontSize="18"
                Background="#00FA9A"/>
    </Grid>
</Page>
