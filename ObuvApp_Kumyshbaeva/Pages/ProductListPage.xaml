<Page x:Class="ObuvApp_Kumyshbaeva.Pages.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ObuvApp_Kumyshbaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductListPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="1"
                   Grid.ColumnSpan="4"
                   Text="Список товаров"
                   FontSize="22"
                   HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
        <Image Source="/Resources/Icon.png"/>
        <ListView Grid.Row="2"
                  Grid.ColumnSpan="6"
                  Grid.RowSpan="4"
                  ItemsSource="{Binding products}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"
                            BorderThickness="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Photo}"
                                   Height="100"
                                   Width="100"/>
                            <StackPanel Grid.Column="1"
                                        Width="700">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProductCategory.Name}"
                                           FontSize="15"/>
                                    <TextBlock Text="{Binding Name, StringFormat={} | {0}}"
                                           FontSize="15"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description, StringFormat={} Описание товара: {0}}"
                                       FontSize="15"/>
                                <TextBlock Text="{Binding Manufacturer.Name}"
                                       FontSize="15"/>
                                <TextBlock Text="{Binding Supplier.Name}"
                                       FontSize="15"/>
                                <TextBlock Text="{Binding Price}"
                                       FontSize="15"/>
                                <TextBlock Text="{Binding Unit.Name}"
                                       FontSize="15"/>
                                <TextBlock Text="{Binding WorkshopCount}"
                                       FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
